NODE_ENV=development
PORT=3000

# PostgreSQL chạy bằng docker compose ở root repository
DATABASE_URL=postgresql://brewlite:brewlite_local_only@127.0.0.1:5432/brewlite?schema=public

# Tối thiểu 32 ký tự. Production phải dùng secret riêng, không dùng giá trị local.
JWT_SECRET=local-only-jwt-secret-at-least-32-characters
JWT_EXPIRES_IN=1h

CORS_ORIGIN=http://localhost:3001,http://127.0.0.1:3001
LOG_LEVEL=info

# Mock payment (ADR-005)
PAYMENT_PROVIDER=mock
PAYMENT_MOCK_DELAY_MS=300
PAYMENT_MOCK_FAILURE_RATE=0
PAYMENT_MOCK_TIMEOUT_RATE=0

# VNPay Sandbox, Return URL only (không IPN/ngrok). Đổi provider thành vnpay để bật.
# Không commit TmnCode/HashSecret thật. Khách nhập thẻ/OTP trên VNPay.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payments/vnpay/return
WEB_BASE_URL=http://localhost:3001

# Thời gian tối đa (giây) để thanh toán đơn PENDING/PAYMENT_FAILED.
# Mặc định 900 = 15 phút. Đặt 30 để demo tự hủy nhanh.
ORDER_PAYMENT_TIMEOUT_SECONDS=900

RUN_MIGRATIONS=false
